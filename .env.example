# Copy to .env and adjust. Never commit .env.
APP_ENV=dev

# --- Database ---
# Dev/test default (SQLite). Production P0 uses Postgres:
# Docker runs in WSL; from Windows use the WSL host IP, not localhost:
# DATABASE_URL=postgresql+asyncpg://ai_power:${POSTGRES_PASSWORD}@192.168.29.100:5432/ai_power
DATABASE_URL=sqlite+aiosqlite:///./ai_power.db
# Required by docker-compose.yml; change it.
POSTGRES_PASSWORD=change-me

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- CORS (comma-separated browser origins) ---
# Vite dev server + LAN web served by nginx in compose.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.29.100:8080

# --- Redis (rate limiting, future job queue) ---
# Docker runs in WSL: use the host IP from Windows, or service name inside compose.
REDIS_URL=redis://192.168.29.100:6379/0

# --- Model providers (OpenAI-compatible) ---
# Streaming read timeout; raise for slow local models under concurrency.
PROVIDER_TIMEOUT_SECONDS=180
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

LOCAL_LLM_BASE_URL=http://192.168.29.100:8083/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=/home/wq/models/qwen2.5-7b-instruct/qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf

EMBEDDING_BASE_URL=http://192.168.29.100:8000/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_HYBRID_ENABLED=true
RETRIEVAL_MAX_CONTEXT_CHARS=6000

# --- Reranker (vLLM / TEI compatible POST /rerank) ---
RERANK_ENABLED=true
RERANK_BASE_URL=http://192.168.29.100:8001/v1
RERANK_API_KEY=
RERANK_MODEL=bge-reranker-v2-m3
RERANK_TIMEOUT_SECONDS=10
RERANK_MAX_CANDIDATES=8
RERANK_MAX_DOC_CHARS=800

# --- Agents ---
AGENT_MAX_STEPS=8
AGENT_TOOL_TIMEOUT_SECONDS=10
AGENT_TOOL_OUTPUT_MAX_CHARS=4000

# --- Admin ---
AUDIT_LOG_RETENTION_DAYS=90

# --- Workflows ---
WORKFLOW_NODE_TIMEOUT_SECONDS=120
WORKFLOW_NODE_ATTEMPTS=2
WORKFLOW_MAX_NODES=20
WORKFLOW_PARALLEL_LIMIT=3
WORKFLOW_REVIEW_TIMEOUT_SECONDS=3600
WORKFLOW_REVIEW_POLL_SECONDS=0.5
WORKFLOW_LOOP_MAX_ITERATIONS=20

# --- Workflow HTTP/MCP outbound ---
HTTP_NODE_TIMEOUT_SECONDS=15
HTTP_NODE_MAX_RESPONSE_CHARS=8000
HTTP_NODE_ALLOWED_HOSTS=
HTTP_NODE_ALLOW_PRIVATE_HOSTS=false
MCP_TIMEOUT_SECONDS=20
MCP_MAX_RESPONSE_CHARS=8000

# --- Long-term memory ---
AGENT_MEMORY_INJECT_LIMIT=5
AGENT_MEMORY_INJECT_CHARS=2000
MEMORY_EMBEDDING_ENABLED=true
MEMORY_EMBEDDING_TIMEOUT_SECONDS=10

# --- Workflow code/database nodes ---
CODE_NODE_MAX_OUTPUT_CHARS=20000
DATABASE_NODE_MAX_ROWS=100
DATABASE_NODE_TIMEOUT_SECONDS=15

# --- Collaboration ---
COLLABORATION_MAX_TASKS=4
COLLABORATION_MAX_ROUNDS=2
COLLABORATION_MAX_STEPS=16
COLLABORATION_PARALLEL_LIMIT=3
COLLABORATION_TASK_TIMEOUT_SECONDS=180

# --- Budget alerts ---
QUOTA_FREE_DAILY_COST_USD=1
QUOTA_PRO_DAILY_COST_USD=50
BUDGET_WEBHOOK_URL=

# --- Webhooks ---
WEBHOOK_SECRET_KEY=
# --- User provider API key encryption ---
PROVIDER_SECRET_KEY=
WEBHOOK_ALLOW_PRIVATE_HOSTS=false
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=5

# --- Optional HTTPS (compose --profile https) ---
# CADDY_DOMAIN=ai.example.com

# --- Ingestion ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=20971520
MAX_DOCUMENT_PAGES=200
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=150
EMBEDDING_BATCH_SIZE=16
INGESTION_MAX_ATTEMPTS=3
INGESTION_LEASE_MINUTES=15